<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Brandlogies — SEO Services in Delhi</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#101826;
    --ink-soft:#2b3546;
    --paper:#FAF9F6;
    --sand:#EEE8DA;
    --green:#2E6E52;
    --green-deep:#1C4536;
    --line:#D8D2C2;
    --slate:#5B6472;
  }

  *{margin:0;padding:0;box-sizing:border-box;}

  html{scroll-behavior:smooth;}

  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'IBM Plex Sans', sans-serif;
    line-height:1.6;
    font-size:16px;
  }

  h1,h2,h3{
    font-family:'Fraunces', serif;
    font-weight:500;
    line-height:1.12;
    color:var(--ink);
  }

  a{color:inherit;text-decoration:none;}

  .wrap{
    max-width:1120px;
    margin:0 auto;
    padding:0 32px;
  }

  /* ---------- Header ---------- */

  header{
    position:sticky;
    top:0;
    z-index:50;
    background:rgba(250,249,246,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--line);
  }

  .nav{
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:20px 32px;
    max-width:1120px;
    margin:0 auto;
  }

  .logo{
    font-family:'Fraunces', serif;
    font-size:22px;
    font-weight:600;
    letter-spacing:-0.01em;
  }

  .nav-links{
    display:flex;
    gap:32px;
    font-size:14.5px;
    color:var(--ink-soft);
  }

  .nav-links a:hover{color:var(--green-deep);}

  .nav-cta{
    background:var(--ink);
    color:var(--paper);
    padding:10px 20px;
    border-radius:2px;
    font-size:14px;
    white-space:nowrap;
  }
  .nav-cta:hover{background:var(--green-deep);}

  .nav-toggle{display:none;}

  /* ---------- Hero ---------- */

  .hero{
    padding:88px 0 96px;
    border-bottom:1px solid var(--line);
  }

  .hero-grid{
    display:grid;
    grid-template-columns:1.15fr 0.85fr;
    gap:56px;
    align-items:center;
  }

  .hero h1{
    font-size:52px;
    letter-spacing:-0.015em;
    max-width:580px;
  }

  .hero h1 em{
    font-style:italic;
    color:var(--green-deep);
  }

  .hero p.lede{
    margin-top:22px;
    max-width:480px;
    font-size:17px;
    color:var(--ink-soft);
  }

  .hero-ctas{
    margin-top:32px;
    display:flex;
    gap:16px;
    align-items:center;
  }

  .btn-primary{
    background:var(--green-deep);
    color:#fff;
    padding:14px 26px;
    border-radius:2px;
    font-size:15px;
    display:inline-block;
  }
  .btn-primary:hover{background:var(--ink);}

  .btn-ghost{
    color:var(--ink);
    font-size:15px;
    border-bottom:1px solid var(--ink);
    padding-bottom:2px;
  }

  /* SERP mockup */

  .serp{
    background:#fff;
    border:1px solid var(--line);
    border-radius:3px;
    padding:24px 24px 8px;
  }

  .serp-search{
    display:flex;
    align-items:center;
    gap:10px;
    border:1px solid var(--line);
    border-radius:24px;
    padding:10px 16px;
    color:var(--slate);
    font-size:14px;
    margin-bottom:20px;
  }

  .serp-dot{
    width:8px;height:8px;border-radius:50%;
    background:var(--green);
    flex-shrink:0;
  }

  .serp-result{
    padding:14px 0;
    border-top:1px solid #EFEBE0;
  }
  .serp-result:first-of-type{border-top:none;}

  .serp-result .url{
    font-size:12.5px;
    color:var(--slate);
    margin-bottom:4px;
  }

  .serp-result .title{
    font-size:16px;
    color:var(--green-deep);
    margin-bottom:4px;
  }

  .serp-result.featured{
    background:var(--sand);
    margin:0 -24px;
    padding:14px 24px;
    border:none;
  }

  .serp-result .desc{
    font-size:13px;
    color:var(--ink-soft);
  }

  .serp-badge{
    display:inline-block;
    font-size:11px;
    color:var(--green-deep);
    background:#E1EEE7;
    padding:2px 8px;
    border-radius:20px;
    margin-bottom:6px;
  }

  /* ---------- Section shell ---------- */

  section{padding:96px 0;}
  section.tight{padding:72px 0;}
  .divider{border-bottom:1px solid var(--line);}

  .kicker{
    font-size:14px;
    color:var(--green-deep);
    margin-bottom:14px;
  }

  .section-head{
    display:grid;
    grid-template-columns:0.6fr 1fr;
    gap:48px;
    margin-bottom:52px;
  }

  .section-head h2{
    font-size:34px;
    max-width:420px;
  }

  .section-head .support{
    color:var(--ink-soft);
    font-size:16px;
    max-width:460px;
    align-self:end;
  }

  /* ---------- Focus list ---------- */

  .focus-grid{
    display:grid;
    grid-template-columns:repeat(4, 1fr);
    border-top:1px solid var(--line);
    border-left:1px solid var(--line);
  }

  .focus-item{
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
    padding:22px 20px;
    font-size:15px;
  }

  /* ---------- Services ---------- */

  .services{
    display:flex;
    flex-direction:column;
  }

  .service-row{
    display:grid;
    grid-template-columns:120px 1fr 1.3fr;
    gap:40px;
    padding:34px 0;
    border-top:1px solid var(--line);
    align-items:baseline;
  }

  .service-row:last-child{border-bottom:1px solid var(--line);}

  .service-index{
    font-family:'Fraunces', serif;
    font-size:15px;
    color:var(--slate);
  }

  .service-row h3{
    font-size:22px;
    font-weight:500;
  }

  .service-row p{
    color:var(--ink-soft);
    font-size:15.5px;
  }

  /* ---------- Why choose ---------- */

  .why-bg{
    background:var(--ink);
    color:var(--paper);
  }

  .why-bg .kicker{color:#8FBFA8;}
  .why-bg h2{color:var(--paper);}
  .why-bg .section-head .support{color:#B7BEC9;}

  .why-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:1px;
    background:rgba(255,255,255,0.14);
  }

  .why-card{
    background:var(--ink);
    padding:32px;
  }

  .why-card h3{
    color:var(--paper);
    font-size:19px;
    margin-bottom:10px;
    font-weight:500;
  }

  .why-card p{
    color:#B7BEC9;
    font-size:14.5px;
  }

  /* ---------- Founder ---------- */

  .founder{
    display:grid;
    grid-template-columns:220px 1fr;
    gap:48px;
    align-items:start;
  }

  .founder-mark{
    width:100%;
    aspect-ratio:1;
    background:var(--sand);
    border:1px solid var(--line);
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Fraunces', serif;
    font-size:52px;
    color:var(--green-deep);
    overflow:hidden;
  }

  .founder-mark img{
    width:100%;
    height:100%;
    object-fit:cover;
    display:block;
    filter:grayscale(0.15);
  }

  .founder-copy h3{
    font-size:24px;
    margin-bottom:4px;
  }

  .founder-copy .role{
    color:var(--green-deep);
    font-size:14.5px;
    margin-bottom:18px;
  }

  .founder-copy p{
    color:var(--ink-soft);
    max-width:640px;
    margin-bottom:14px;
    font-size:15.5px;
  }

  /* ---------- Process ---------- */

  .process-list{
    border-top:1px solid var(--line);
  }

  .process-item{
    display:grid;
    grid-template-columns:64px 1fr;
    gap:28px;
    padding:28px 0;
    border-bottom:1px solid var(--line);
  }

  .process-num{
    font-family:'Fraunces', serif;
    font-size:20px;
    color:var(--green-deep);
  }

  .process-item h3{
    font-size:19px;
    margin-bottom:6px;
    font-weight:500;
  }

  .process-item p{
    color:var(--ink-soft);
    font-size:15px;
    max-width:560px;
  }

  /* ---------- Growth statement ---------- */

  .statement{
    background:var(--sand);
  }

  .statement blockquote{
    font-family:'Fraunces', serif;
    font-size:30px;
    line-height:1.35;
    max-width:760px;
    color:var(--ink);
  }

  .statement p.follow{
    margin-top:22px;
    max-width:600px;
    color:var(--ink-soft);
    font-size:15.5px;
  }

  /* ---------- Final CTA ---------- */

  .final-cta{
    text-align:left;
    display:grid;
    grid-template-columns:1.2fr 0.8fr;
    gap:40px;
    align-items:center;
  }

  .final-cta h2{
    font-size:38px;
    max-width:480px;
  }

  .final-cta .support{
    color:var(--ink-soft);
    font-size:16px;
    margin-top:14px;
    max-width:420px;
  }

  .final-actions{
    display:flex;
    flex-direction:column;
    gap:14px;
    align-items:flex-start;
  }

  /* ---------- Footer ---------- */

  footer{
    border-top:1px solid var(--line);
    padding:32px;
  }

  .footer-inner{
    max-width:1120px;
    margin:0 auto;
    display:flex;
    justify-content:space-between;
    align-items:center;
    font-size:13.5px;
    color:var(--slate);
  }

  /* ---------- Responsive ---------- */

  @media(max-width:860px){
    .nav-links{display:none;}
    .hero h1{font-size:38px;}
    .hero-grid{grid-template-columns:1fr;}
    .section-head{grid-template-columns:1fr;gap:16px;}
    .focus-grid{grid-template-columns:repeat(2,1fr);}
    .service-row{grid-template-columns:1fr;gap:8px;}
    .why-grid{grid-template-columns:1fr;}
    .founder{grid-template-columns:1fr;}
    .founder-mark{width:96px;height:96px;font-size:34px;}
    .final-cta{grid-template-columns:1fr;}
    .statement blockquote{font-size:24px;}
  }

  @media(prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
  }

  :focus-visible{
    outline:2px solid var(--green-deep);
    outline-offset:2px;
  }
</style>
</head>
